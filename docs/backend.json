
{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Stores public information about a user.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID." },
        "displayName": { "type": "string", "description": "User's public display name." },
        "email": { "type": "string", "format": "email" },
        "photoURL": { "type": "string", "description": "URL of the user's profile picture." },
        "cardTheme": { "type": "string", "description": "The selected color theme for the user's card." },
        "groupId": { "type": "string", "description": "ID of the group the user belongs to, or null." },
        "pairedWith": { "type": "string", "description": "UID of the paired user, or null." }
      },
      "required": ["uid", "email", "displayName"]
    },
    "Group": {
      "title": "Group",
      "description": "Represents a group of users.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "invitationCode": { "type": "string" },
        "createdBy": { "type": "string", "description": "UID of the user who created the group." },
        "members": {
          "type": "object",
          "description": "A map of user UIDs to their roles in the group.",
          "additionalProperties": {
            "type": "string",
            "enum": ["admin", "co-admin", "member"]
          }
        },
        "lastKickedUid": {
            "type": "string",
            "description": "UID of the last user kicked, for security rules."
        }
      },
      "required": ["name", "invitationCode", "createdBy", "members"]
    },
    "Task": {
      "title": "Task",
      "description": "Represents a single task item.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string" },
        "isCompleted": { "type": "boolean" },
        "createdAt": { "type": "number", "description": "Timestamp" },
        "timeSpent": { "type": "number", "description": "in seconds" },
        "timerState": { "type": "string", "enum": ["stopped", "running", "paused"] },
        "timerStartedAt": { "type": "number", "description": "Timestamp or null" }
      },
      "required": ["id", "text", "isCompleted", "createdAt"]
    },
    "PreviousTask": {
      "title": "Previous Task",
      "description": "A simplified task object for historical records.",
      "type": "object",
      "properties": {
        "text": { "type": "string" }
      },
      "required": ["text"]
    },
    "TaskList": {
      "title": "User's Task List",
      "description": "The complete state for a single user's task list.",
      "type": "object",
      "properties": {
        "tasks": { "type": "array", "items": { "$ref": "#/entities/Task" } },
        "previousTasks": { "type": "array", "items": { "$ref": "#/entities/PreviousTask" } },
        "isLocked": { "type": "boolean" },
        "isFinished": { "type": "boolean" },
        "totalCompleted": { "type": "number" },
        "totalAssigned": { "type": "number"},
        "currentStreak": { "type": "number" },
        "maxStreak": { "type": "number" },
        "lockedAt": { "type": "number", "description": "Timestamp or null" },
        "lastLockedAt": { "type": "number", "description": "Timestamp or null" }
      }
    },
    "PairInvitation": {
      "title": "Pair Invitation",
      "description": "Represents a pairing invitation between two users.",
      "type": "object",
      "properties": {
        "id": { "type": "string"},
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "receiverId": { "type": "string" },
        "receiverName": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "accepted", "declined", "cancelled"] },
        "createdAt": { "type": "number", "description": "Timestamp" }
      },
      "required": ["id", "senderId", "senderName", "receiverId", "receiverName", "status", "createdAt"]
    },
    "GroupInvitation": {
      "title": "Group Invitation",
      "description": "Represents a group invitation sent via email.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "groupId": { "type": "string" },
        "groupName": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "receiverEmail": { "type": "string", "format": "email" },
        "status": { "type": "string", "enum": ["pending", "accepted", "declined"] },
        "createdAt": { "type": "number", "description": "Timestamp" }
      },
      "required": ["id", "groupId", "groupName", "senderId", "senderName", "receiverEmail", "status", "createdAt"]
    }
  },
  "auth": {
    "providers": ["email"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Stores public profiles for all users."
    },
    "/groups/{groupId}": {
      "schema": { "$ref": "#/entities/Group" },
      "description": "Stores information about user groups."
    },
    "/task_lists/{userId}": {
      "schema": { "$ref": "#/entities/TaskList" },
      "description": "Stores the private task list for each user."
    },
    "/pair_invitations/{invitationId}": {
        "schema": { "$ref": "#/entities/PairInvitation" },
        "description": "Stores pairing invitations between users."
    },
    "/group_invitations/{invitationId}": {
        "schema": { "$ref": "#/entities/GroupInvitation" },
        "description": "Stores group invitations sent via email."
    },
    "/riyalTodoState/app": {
      "schema": { "$ref": "#/entities/AppState" },
      "description": "LEGACY: A single document containing the state for the original three users. This will no longer be actively used for new users."
    },
    "/user_roles/{userId}": {
      "schema": { "$ref": "#/entities/UserRole" },
      "description": "LEGACY: Maps a user's UID to their corresponding list name (e.g., 'riya'). This will no longer be actively used for new users."
    }
  }
}
