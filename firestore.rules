
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    // --- New Scalable Rules ---
    // Temporarily opened for development. Any signed-in user can read/write.

    match /users/{userId} {
      allow read, write: if isSignedIn();
    }
    
    match /task_lists/{userId} {
      allow read, write: if isSignedIn();
    }
    
    match /groups/{groupId} {
      allow read, write: if isSignedIn();
    }

    // --- Legacy Rules ---
    // Re-enabled writes for the legacy app so it remains functional.

    match /riyalTodoState/app {
      allow read, write: if isSignedIn();
    }
    
    // The original user roles are kept for reference but are not actively used.
    match /user_roles/{userId} {
      allow read: if true;
      allow write: if false; 
    }
  }
}
