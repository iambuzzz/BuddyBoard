
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function getRole(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)).data.members[request.auth.uid];
    }
    
    function isAdmin(groupId) {
        return getRole(groupId) == 'admin';
    }

    function isCoAdmin(groupId) {
        let role = getRole(groupId);
        return role == 'admin' || role == 'co-admin';
    }
    
    // --- New Scalable Rules ---

    match /users/{userId} {
      allow read, list: if isSignedIn();
      // Allow write if owner.
      // Also allow write if the user is being unpaired by their partner.
      allow write: if isOwner(userId) ||
                     (resource.data.pairedWith == request.auth.uid && request.resource.data.pairedWith == null);
    }
    
    match /task_lists/{userId} {
      allow read: if isOwner(userId) || 
                     (resource.data.groupId != null && get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.members[request.auth.uid] != null);
      allow write: if isOwner(userId);
    }
    
    match /groups/{groupId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      // Admins can update anything.
      // Co-admins can only kick normal members.
      // Normal users can only remove themselves from the members list.
      allow update: if isSignedIn() && (
        isAdmin(groupId) ||
        (isCoAdmin(groupId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']) && !((request.auth.uid in resource.data.members) && (getRole(groupId) in ['admin', 'co-admin']))) ||
        (request.auth.uid in resource.data.members && !(request.auth.uid in request.resource.data.members) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']))
      );
      allow delete: if isSignedIn() && isAdmin(groupId);
    }
    
    match /pair_invitations/{invitationId} {
        allow create: if isSignedIn();
        allow read: if isSignedIn() && (request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.receiverId);
        allow update: if isSignedIn() && (
            (request.auth.uid == resource.data.receiverId && request.resource.data.status in ['accepted', 'declined']) ||
            (request.auth.uid == resource.data.senderId && request.resource.data.status == 'cancelled')
        );
        allow delete: if isSignedIn() && request.auth.uid == resource.data.senderId && resource.data.status == 'pending';
    }
    
    match /group_invitations/{invitationId} {
      allow read: if isSignedIn() && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email == resource.data.receiverEmail || isCoAdmin(resource.data.groupId));
      allow create: if isSignedIn() && isCoAdmin(request.resource.data.groupId);
      allow update: if isSignedIn() && (
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email == resource.data.receiverEmail && request.resource.data.status in ['accepted', 'declined']) ||
        isCoAdmin(resource.data.groupId)
      );
      allow delete: if isSignedIn() && isCoAdmin(resource.data.groupId);
    }


    // --- Legacy Rules ---
    match /riyalTodoState/app {
      allow read, write: if isSignedIn();
    }
    
    match /user_roles/{userId} {
      allow read: if true;
      allow write: if false; 
    }
  }
}

    