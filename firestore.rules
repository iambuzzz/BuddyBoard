
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function role(group) {
      return group.members[request.auth.uid];
    }
    
    function kickedUserRole(group) {
      return group.members[request.resource.data.lastKickedUid];
    }
    
    // --- New Scalable Rules ---

    match /users/{userId} {
      allow read: if isSignedIn();
      // Allow writes if you are the owner, OR if the groupId is being removed (by an admin),
      // OR if the pairing status is changing.
      allow write: if isSignedIn() && (isOwner(userId) || (request.resource.data.groupId == null && resource.data.groupId != null) || request.resource.data.pairedWith != resource.data.pairedWith);
    }
    
    match /task_lists/{userId} {
      allow read: if isOwner(userId) || 
                     (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.pairedWith == userId) ||
                     (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.groupId != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.groupId == get(/databases/$(database)/documents/users/$(userId)).data.groupId);
      allow write: if isOwner(userId);
    }
    
    match /groups/{groupId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        // ADMIN -> CAN DO ANYTHING
        role(resource.data) == "admin"
        ||
        // CO-ADMIN -> CAN KICK ONLY MEMBERS
        (role(resource.data) == "co-admin" && kickedUserRole(resource.data) == "member")
        ||
        // MEMBER -> CAN LEAVE SELF or JOIN
        (request.auth.uid in resource.data.members && !(request.auth.uid in request.resource.data.members)) ||
        (!(request.auth.uid in resource.data.members) && request.auth.uid in request.resource.data.members)
      );
      allow delete: if role(resource.data) == "admin";
    }
    
    match /pair_invitations/{invitationId} {
        allow create: if isSignedIn();
        allow read: if isSignedIn() && (request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.receiverId);
        allow update: if isSignedIn() && (
            (request.auth.uid == resource.data.receiverId && request.resource.data.status in ['accepted', 'declined']) ||
            (request.auth.uid == resource.data.senderId && request.resource.data.status == 'cancelled')
        );
        allow delete: if isSignedIn() && request.auth.uid == resource.data.senderId && resource.data.status == 'pending';
    }
    
    match /group_invitations/{invitationId} {
      allow read: if isSignedIn() && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email == resource.data.receiverEmail || role(get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data) == 'admin' || role(get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data) == 'co-admin');
      allow create: if isSignedIn() && (role(get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data) == 'admin' || role(get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data) == 'co-admin');
      allow update: if isSignedIn() && (
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email == resource.data.receiverEmail && request.resource.data.status in ['accepted', 'declined']) ||
        role(get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data) == 'admin' || role(get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data) == 'co-admin'
      );
      allow delete: if isSignedIn() && (role(get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data) == 'admin' || role(get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data) == 'co-admin');
    }


    // --- Legacy Rules ---
    match /riyalTodoState/app {
      allow read, write: if isSignedIn();
    }
    
    match /user_roles/{userId} {
      allow read: if true;
      allow write: if false; 
    }
  }
}
