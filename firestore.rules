/**
 * @fileoverview Firestore Security Rules for riyalTodoState application.
 *
 * Core Philosophy:
 * This ruleset enforces a role-based access control model, where users are assigned to a specific
 * list (riya, naitik, or ambuj) and can only modify the part of the global application state
 * associated with their list. It also enforces user-ownership for the `user_roles` collection,
 * where each user can only manage their own role mapping.
 *
 * Data Structure:
 * - `/riyalTodoState/app`: A single document containing the entire application state,
 *   structured with separate UserState objects for 'riya', 'naitik', and 'ambuj'.
 * - `/user_roles/{userId}`: Documents mapping a user's UID to their list name.
 *
 * Key Security Decisions:
 * - The `AppState` document at `/riyalTodoState/app` is secured using role-based access
 *   control. Only authenticated users whose role matches the `lastUpdater` field can update the document.
 * - User roles are managed in the `/user_roles/{userId}` collection, where each user can
 *   only create, update, or delete their own role document.
 * - Data shape validation is minimized to allow for rapid prototyping, focusing primarily on
 *   authorization and relational integrity checks.
 *
 * Denormalization for Authorization:
 *  - The `lastUpdater` field within the `/riyalTodoState/app` document is critical for authorization.
 *    Updates are only allowed if the user's role matches this field. This avoids the need for
 *    complex queries or joins during security rule evaluation.
 *  - The `/user_roles/{userId}` collection links a user's UID to their role, ensuring that only
 *    authorized users can modify the application state related to their specific list.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secures the global application state document.
     * @path /riyalTodoState/app
     * @allow (update) User with role 'riya' updates the document when lastUpdater is 'riya'.
     * @deny (update) User with role 'naitik' attempts to update the document when lastUpdater is 'riya'.
     * @principle Enforces role-based access control for updates to the global application state.
     */
    match /riyalTodoState/app {
      allow get: if true;
      allow list: if false;
      allow create: if false;
      allow update: if isSignedIn() && isAuthorizedUpdater(request.auth.uid, resource.data.lastUpdater);
      allow delete: if false;
    }

    /**
     * @description Secures user role documents, allowing each user to manage their own role.
     * @path /user_roles/{userId}
     * @allow (create) User creates their own role mapping.
     * @allow (update) User updates their own role mapping.
     * @allow (delete) User deletes their own role mapping.
     * @deny (create) User attempts to create a role mapping for another user.
     * @principle Enforces user-ownership for managing role assignments.
     */
    match /user_roles/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isExistingOwner(userId);
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    function getUserRole(userId) {
      return get(/databases/$(database)/documents/user_roles/$(userId)).data.listName;
    }

    function isAuthorizedUpdater(userId, lastUpdater) {
      return getUserRole(userId) == lastUpdater;
    }
  }
}