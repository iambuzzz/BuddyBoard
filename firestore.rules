
/**
 * @fileoverview Firestore Security Rules for the new multi-tenant TaskFlipper app.
 *
 * Core Philosophy:
 * This ruleset establishes a robust security model for a multi-user, group-based application.
 * Each user has full control over their own data (profile and task list), and group access
 * is managed through roles (admin/member) defined within each group document.
 * The legacy data model remains readable but not writable to prevent interference.
 *
 * New Data Structure:
 * - /users/{userId}: Public user profiles. Users can create their own and update it. Anyone can read.
 * - /groups/{groupId}: Group definitions. Contains a members map with roles.
 * - /task_lists/{userId}: A user's private task list. Only the owner can read or write.
 *
 * Legacy Data Structure (Read-Only):
 * - /riyalTodoState/app: The original app state.
 * - /user_roles/{userId}: The original user-to-list mapping.
 *
 * Key Security Decisions:
 * - User data is strictly owned: A user can only write to their own /users/{userId} and /task_lists/{userId} documents.
 * - Group write access is role-based: Admins can update, and non-members can join as 'member'.
 * - Group read access: Any member of a group can read the group document.
 * - Invitation codes are part of the group document and are thus protected by the same read rules.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isGroupMember(groupId) {
      return isSignedIn() && get(/databases/$(database)/documents/groups/$(groupId)).data.members[request.auth.uid] != null;
    }

    function isGroupAdmin(groupId) {
      return isSignedIn() && get(/databases/$(database)/documents/groups/$(groupId)).data.members[request.auth.uid] == 'admin';
    }
    
    function isNewGroupAdmin() {
      // Check if the user is making themselves the admin in a new group creation.
      return resource == null 
        && request.resource.data.members[request.auth.uid] == 'admin'
        && request.resource.data.members.size() == 1;
    }
    
    function isJoiningGroupAsMember() {
      // A user is joining if:
      // 1. They are signed in.
      // 2. They were not a member before the update.
      // 3. The new members map is exactly one larger than the old one.
      // 4. Their own UID is being added with the role 'member'.
      // 5. No other fields are being changed besides the members map.
      let existingMembers = resource.data.members;
      let newMembers = request.resource.data.members;
      
      return isSignedIn()
        && !existingMembers.keys().hasAny([request.auth.uid])
        && newMembers.size() == existingMembers.size() + 1
        && newMembers[request.auth.uid] == 'member'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']);
    }

    // --- New Scalable Rules ---

    // User can create and update their own profile. Any signed-in user can read profiles.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
    }
    
    // User can create and manage their own private task list.
    match /task_lists/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    // Group Rules:
    match /groups/{groupId} {
      allow create: if isSignedIn() && isNewGroupAdmin();
      allow read: if isGroupMember(groupId);
      allow update: if isGroupAdmin(groupId) || isJoiningGroupAsMember();
      allow delete: if isGroupAdmin(groupId);
    }

    // --- Legacy Read-Only Rules ---

    // The original app state is now read-only to preserve history.
    match /riyalTodoState/app {
      allow read: if true;
      allow write: if false; // Prevent any modification
    }
    
    // The original user roles are now read-only.
    match /user_roles/{userId} {
      allow read: if true;
      allow write: if false; // Prevent any modification
    }
  }
}
